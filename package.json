{
	"name": "chaindata",
	"private": true,
	"type": "module",
	"description": "A community controlled index of relay/parachain assets to suppliment on-chain data, allowing developers to easily leverage the latest parachain information when building within the polkadot ecosystem.",
	"repository": "https://github.com/TalismanSociety/chaindata.git",
	"author": "Talisman Devs <devs@talisman.community>",
	"keywords": [],
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/TalismanSociety/chaindata/issues"
	},
	"homepage": "https://talisman.community",
	"packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"scripts": {
		"prepare": "husky",
		"format": "biome check --write . && prettier --write \"**/*.{md,html,yaml}\"",
		"validate-yaml": "prettier --write data/*.yaml",
		"validate-schema": "pnpm tsx scripts/validate-schema.ts",
		"validate": "pnpm run validate-yaml && pnpm run validate-schema",
		"find-missing-coingeckoIds": "tsx scripts/find-missing-coingeckoIds.ts",
		"find-pah-foreign-assets": "tsx scripts/find-pah-foreign-assets.ts",
		"report-erc20-aggregator": "pnpm tsx scripts/report-erc20-aggregator.ts",
		"report-metadata-versions": "pnpm tsx scripts/report-metadata-versions.ts",
		"cleanup-dead-rpcs": "pnpm tsx scripts/cleanup-dead-rpcs.ts",
		"papi-console-sync": "pnpm tsx scripts/papi-console-sync.ts",
		"typecheck": "tsc --noEmit",
		"generate-schemas": "tsx scripts/generate-schemas.ts",
		"fetch-external": "tsx scripts/fetch-external.ts",
		"fetch-tao-hotkey-logos": "tsx scripts/fetch-tao-hotkey-logos.ts",
		"build": "pnpm run validate && tsx scripts/build.ts",
		"build:dev": "tsx scripts/build.ts",
		"clean": "rm -rf pub",
		"prepare-pr-merge": "git fetch origin main && git restore --source=origin/main --staged --worktree data/cache data/generated assets/tokens/coingecko",
		"postinstall": "pnpm generate-schemas"
	},
	"dependencies": {
		"@polkadot-api/descriptors": "workspace:*",
		"@polkadot-api/substrate-bindings": "0.21.2",
		"@polkadot-api/substrate-client": "0.7.0",
		"@solana/kit": "8.6.0",
		"@supercharge/promise-pool": "^3.3.0",
		"@talismn/balances": "3.1.1",
		"@talismn/chain-connectors": "1.1.1",
		"@talismn/chaindata-provider": "2.3.1",
		"@talismn/crypto": "1.2.0",
		"@talismn/sapi": "3.0.0",
		"@talismn/scale": "3.0.0",
		"dotenv": "^18.0.9",
		"extract-colors": "^4.2.1",
		"lodash": "^4.18.1",
		"polkadot-api": "3.3.0",
		"rxjs": "^7.8.2",
		"sharp": "^0.35.5",
		"tinycolor2": "^1.6.0",
		"toml": "^5.0.1",
		"url-join": "^6.0.0",
		"viem": "2.57.16",
		"ws": "^8.22.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/lodash": "^4.17.27",
		"@types/node": "^24.19.2",
		"@types/tinycolor2": "^1.4.6",
		"@types/ws": "^8.18.2",
		"anylogger": "^1.0.11",
		"anylogger-loglevel": "^1.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"loglevel": "^1.9.2",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"prettier": {
		"printWidth": 120,
		"semi": false,
		"singleQuote": true
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json}": "biome check --write --no-errors-on-unmatched --error-on-warnings",
		"*.{md,html,yaml}": "prettier --write"
	}
}
